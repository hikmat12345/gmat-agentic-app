# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root + all subdirectories)
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
**/coverage/

# next.js (root + all subdirectories)
**/.next/
**/out/

# production
**/build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example
!agents/.env.example

# drizzle
/drizzle

# python
__pycache__/
*.pyc
.venv/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

.supabase/